<%- include('partials/head') %>
<main class="min-h-[calc(100vh-260px)]"><div class="max-w-6xl mx-auto px-5 py-8">
    <div class="flex flex-wrap justify-between gap-4 items-center mb-8"><a href="/" class="flex items-center gap-2.5"><img src="/images/logo.jpg" alt="SyahWash Logo" class="h-10 w-auto object-contain rounded-xl shadow-sm border border-stone-200 bg-white p-0.5"><span class="font-display font-bold text-xl text-stone-900 tracking-tight">Syah<span class="text-[#f38d38]">Wash</span></span></a><div class="flex items-center gap-3"><a href="/kelola" class="btn-pill-light text-xs sm:text-sm py-2 px-4">Kelola Layanan</a><a href="/chatbot" class="btn-pill-light text-xs sm:text-sm py-2 px-4">Tanya AI</a><form method="POST" action="/logout"><button class="btn-pill-orange text-xs sm:text-sm py-2 px-4">Keluar</button></form></div></div>
    <p class="eyebrow">DASHBOARD ADMIN</p><h1 class="section-title mb-6">Kelola Status Pesanan</h1>
    <div class="overflow-x-auto bg-white border border-blue-100 rounded-xl"><table class="w-full text-sm"><thead class="bg-blue-50 text-sky-950 text-left"><tr><th class="p-4">Kode / Pelanggan</th><th class="p-4">Layanan</th><th class="p-4">Berat / Total</th><th class="p-4">Estimasi</th><th class="p-4">Status</th></tr></thead><tbody><% if (!pesanan.length) { %><tr><td colspan="5" class="p-6 text-center text-slate-500">Belum ada pesanan masuk.</td></tr><% } %><% pesanan.forEach(item => { %><tr class="border-t border-slate-100"><td class="p-4"><b class="text-sky-950"><%= item.kode %></b><span class="block text-slate-500"><%= item.namaPelanggan %></span></td><td class="p-4"><%= item.layanan %></td><td class="p-4"><%= item.berat %> kg<span class="block text-slate-500"><%= formatRupiah(item.hargaPerKg * item.berat) %></span></td><td class="p-4"><%= new Date(item.estimasiSelesai).toLocaleDateString('id-ID') %></td><td class="p-4"><form method="POST" action="/admin/pesanan/<%= item.id %>/status" class="flex gap-2"><select name="status" class="border border-blue-200 rounded-lg px-2 py-1.5"><% statuses.forEach(status => { %><option value="<%= status %>" <%= status === item.status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="btn-primary text-xs py-1.5 px-3">Simpan</button></form></td></tr><% }) %></tbody></table></div>
</div></main>
<%- include('partials/footer') %>
