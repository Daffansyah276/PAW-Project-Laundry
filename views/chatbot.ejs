<%- include('partials/head') %>

    <div class="max-w-5xl mx-auto px-5 py-6">
        <!-- Navbar -->
        <nav class="flex justify-between items-center mb-14 border-b border-blue-100 pb-5">
            <a href="/" class="text-2xl font-bold tracking-tight text-blue-600">Laundry Syah Jehan</a>
            <div class="flex items-center gap-5 text-sm font-semibold text-slate-700">
                <a href="/" class="hover:text-blue-600 transition">Beranda</a>
                <% if (currentUser && currentUser.role === 'admin') { %>
                    <a href="/admin/pesanan" class="text-blue-700 font-bold hover:text-blue-900 transition">Dashboard Admin</a>
                <% } else if (currentUser) { %>
                    <a href="/pesanan-saya" class="text-blue-700 font-bold hover:text-blue-900 transition">Pesanan Saya</a>
                <% } %>
                <a href="/kelola" class="hover:text-blue-600 transition">Kelola Layanan</a>
            </div>
        </nav>

        <!-- Header -->
        <div class="mb-8 text-center">
            <h2 class="text-[2.5rem] font-extrabold text-slate-900 leading-tight mb-3 tracking-tight">
                AI Assistant 🤖
            </h2>
            <p class="text-slate-500 text-[0.95rem]">
                Tanyakan apa saja seputar layanan Laundry Syah Jehan. Didukung oleh Google Gemini.
            </p>
        </div>

        <!-- Chat Container -->
        <div class="flex flex-col bg-white rounded-2xl shadow-xl shadow-blue-950/5 border border-blue-100 overflow-hidden"
            style="height: 70vh; max-height: 680px;">

            <!-- Chat Messages Area -->
            <div id="chatMessages" class="flex-1 overflow-y-auto p-6 space-y-4 bg-slate-50/70">
                <!-- Pesan Awal dari AI -->
                <div class="flex items-start gap-3">
                    <div
                        class="w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center flex-shrink-0 shadow-sm">
                        <span class="text-white text-sm font-bold">AI</span>
                    </div>
                    <div class="bg-slate-100 rounded-2xl rounded-tl-sm px-4 py-3 max-w-[75%] shadow-sm">
                        <p class="text-slate-800 text-sm leading-relaxed">
                            Halo! Saya adalah AI Assistant Laundry Syah Jehan. 👋<br><br>
                            Saya siap membantu Anda mendapatkan informasi tentang layanan, harga, dan produk laundry
                            kami. Silakan ajukan pertanyaan Anda!
                        </p>
                    </div>
                </div>
            </div>

            <!-- Divider -->
            <div class="border-t border-slate-200"></div>

            <!-- Input Area -->
            <div class="p-4 bg-white">
                <!-- Error Banner -->
                <div id="errorBanner"
                    class="hidden mb-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-2 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none"
                        viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span id="errorText"></span>
                </div>

                <form id="chatForm" class="flex gap-3 items-end">
                    <div class="flex-1 relative">
                        <textarea id="messageInput" placeholder="Ketik pertanyaan Anda di sini... (maks. 500 karakter)"
                            maxlength="500" rows="1"
                            class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none transition-all"
                            style="min-height: 48px; max-height: 120px;" oninput="autoResize(this)"></textarea>
                        <span id="charCount" class="absolute bottom-2 right-3 text-xs text-slate-400">0/500</span>
                    </div>
                    <button type="submit" id="sendBtn"
                        class="bg-blue-600 hover:bg-blue-700 disabled:bg-slate-400 text-white font-semibold px-5 py-3 rounded-xl transition shadow-sm flex items-center gap-2 flex-shrink-0">
                        <span id="sendBtnText">Kirim</span>
                        <svg id="sendIcon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                        <!-- Loading spinner (hidden by default) -->
                        <svg id="loadingIcon" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg"
                            fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                            </circle>
                            <path class="opacity-75" fill="currentColor"
                                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                    </button>
                </form>
                <p class="text-xs text-slate-400 mt-2 text-center">AI hanya menjawab pertanyaan seputar layanan Laundry
                    Syah Jehan.</p>
            </div>
        </div>
    </div>

    <script>
        const chatMessages = document.getElementById('chatMessages');
        const chatForm = document.getElementById('chatForm');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');
        const sendBtnText = document.getElementById('sendBtnText');
        const sendIcon = document.getElementById('sendIcon');
        const loadingIcon = document.getElementById('loadingIcon');
        const errorBanner = document.getElementById('errorBanner');
        const errorText = document.getElementById('errorText');
        const charCount = document.getElementById('charCount');

        // Auto-resize textarea
        function autoResize(el) {
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 120) + 'px';
            charCount.textContent = el.value.length + '/500';
        }

        // Kirim dengan Enter (Shift+Enter = newline)
        messageInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                chatForm.requestSubmit();
            }
        });

        // Tambah pesan ke chat
        function addMessage(role, text) {
            const isUser = role === 'user';
            const wrapper = document.createElement('div');
            wrapper.className = `flex items-start gap-3 ${isUser ? 'flex-row-reverse' : ''}`;

            const avatar = document.createElement('div');
            avatar.className = `w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 shadow-sm ${isUser ? 'bg-slate-700' : 'bg-blue-600'}`;
            avatar.innerHTML = `<span class="text-white text-xs font-bold">${isUser ? 'Anda' : 'AI'}</span>`;

            const bubble = document.createElement('div');
            bubble.className = `rounded-2xl px-4 py-3 max-w-[75%] shadow-sm text-sm leading-relaxed ${isUser
                    ? 'bg-blue-600 text-white rounded-tr-sm'
                    : 'bg-slate-100 text-slate-800 rounded-tl-sm'
                }`;
            // textContent mencegah pesan pengguna/API mengeksekusi HTML.
            bubble.textContent = text;
            bubble.style.whiteSpace = 'pre-wrap';

            wrapper.appendChild(avatar);
            wrapper.appendChild(bubble);
            chatMessages.appendChild(wrapper);
            scrollToBottom();
        }

        // Tambah indikator loading (typing bubble)
        function addTypingIndicator() {
            const wrapper = document.createElement('div');
            wrapper.id = 'typingIndicator';
            wrapper.className = 'flex items-start gap-3';

            const avatar = document.createElement('div');
            avatar.className = 'w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center flex-shrink-0 shadow-sm';
            avatar.innerHTML = '<span class="text-white text-xs font-bold">AI</span>';

            const bubble = document.createElement('div');
            bubble.className = 'bg-slate-100 rounded-2xl rounded-tl-sm px-5 py-4 shadow-sm flex items-center gap-1.5';
            bubble.innerHTML = `
            <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
            <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
            <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
        `;

            wrapper.appendChild(avatar);
            wrapper.appendChild(bubble);
            chatMessages.appendChild(wrapper);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typingIndicator');
            if (indicator) indicator.remove();
        }

        function scrollToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function setLoading(isLoading) {
            sendBtn.disabled = isLoading;
            messageInput.disabled = isLoading;
            sendBtnText.textContent = isLoading ? 'Memproses' : 'Kirim';
            sendIcon.classList.toggle('hidden', isLoading);
            loadingIcon.classList.toggle('hidden', !isLoading);
        }

        function showError(msg) {
            errorText.textContent = msg;
            errorBanner.classList.remove('hidden');
            setTimeout(() => errorBanner.classList.add('hidden'), 5000);
        }

        // Handle submit
        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = messageInput.value.trim();

            // Validasi frontend
            if (!message) {
                showError('Pesan tidak boleh kosong.');
                return;
            }
            if (message.length > 500) {
                showError('Pesan terlalu panjang. Maksimal 500 karakter.');
                return;
            }

            // Sembunyikan error sebelumnya
            errorBanner.classList.add('hidden');

            // Tampilkan pesan pengguna
            addMessage('user', message);

            // Reset input
            messageInput.value = '';
            messageInput.style.height = 'auto';
            charCount.textContent = '0/500';

            // Set loading state
            setLoading(true);
            addTypingIndicator();

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ message }),
                });

                const result = await response.json();
                removeTypingIndicator();

                if (result.success && result.data && result.data.reply) {
                    addMessage('ai', result.data.reply);
                } else {
                    const errMsg = result.error || 'Terjadi kesalahan. Silakan coba lagi.';
                    showError(errMsg);
                    addMessage('ai', `⚠️ ${errMsg}`);
                }
            } catch (err) {
                removeTypingIndicator();
                const errMsg = 'Gagal terhubung ke server. Pastikan koneksi internet Anda aktif.';
                showError(errMsg);
                addMessage('ai', `⚠️ ${errMsg}`);
            } finally {
                setLoading(false);
                messageInput.focus();
            }
        });
    </script>

    <%- include('partials/footer') %>