<%- include('partials/head') %>

    <main class="min-h-screen py-6 px-4 sm:px-6">
        <div class="max-w-4xl mx-auto">
            <!-- Navbar -->
            <nav class="flex justify-between items-center mb-8 pb-5 border-b border-stone-200/80">
                <a href="/" class="flex items-center gap-2.5 group">
                    <img src="/images/logo.jpg" alt="SyahWash Logo" class="h-10 w-auto object-contain rounded-xl shadow-sm border border-stone-200/80 group-hover:scale-105 transition-transform bg-white p-0.5">
                    <span class="font-display font-bold text-xl text-stone-900 tracking-tight">Syah<span
                            class="text-[#f38d38]">Wash</span></span>
                </a>
                <div class="flex items-center gap-5 text-xs sm:text-sm font-semibold text-stone-600">
                    <a href="/" class="hover:text-[#f38d38] transition">Beranda</a>
                    <a href="/#layanan" class="hover:text-[#f38d38] transition">Layanan</a>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <a href="/admin/pesanan"
                            class="text-[#e87b24] font-bold hover:text-stone-900 transition">Dashboard Admin</a>
                        <a href="/kelola" class="hover:text-[#f38d38] transition font-bold text-[#e87b24]">Kelola Layanan</a>
                    <% } else if (currentUser) { %>
                        <a href="/pesanan-saya"
                            class="text-[#e87b24] font-bold hover:text-stone-900 transition">Pesanan Saya</a>
                    <% } %>
                </div>
            </nav>

            <!-- Header -->
            <div class="mb-6 text-center">
                <span
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-100/70 text-[#e87b24] font-bold text-xs mb-2">
                    Google Gemini AI Powered
                </span>
                <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
                    AI Laundry Assistant
                </h1>
                <p class="text-stone-500 text-xs sm:text-sm mt-1 max-w-md mx-auto">
                    Konsultasikan estimasi waktu selesai, daftar harga layanan, serta rekomendasi takaran &amp; aroma
                    pewangi pakaian.
                </p>
            </div>

            <!-- Chat Container -->
            <div class="flex flex-col bg-white rounded-3xl shadow-xl shadow-stone-900/5 border border-stone-200/90 overflow-hidden"
                style="height: 68vh; max-height: 650px;">

                <!-- Chat Messages Area -->
                <div id="chatMessages" class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-4 bg-[#faf7f2]/50">
                    <!-- Pesan Awal dari AI -->
                    <div class="flex items-start gap-3">
                        <div
                            class="w-9 h-9 rounded-xl bg-[#f38d38] flex items-center justify-center flex-shrink-0 shadow-sm text-white font-display font-extrabold text-xs">
                            AI
                        </div>
                        <div
                            class="bg-white border border-stone-200/80 rounded-2xl rounded-tl-sm px-4 py-3 max-w-[80%] shadow-sm">
                            <p class="text-stone-800 text-xs sm:text-sm leading-relaxed">
                                Halo! Saya adalah <b>AI Assistant SyahWash</b>. 👋<br><br>
                                Saya siap membantu Anda dengan informasi tarif &amp; layanan kiloan/satuan, estimasi
                                waktu selesai pesanan, dan rekomendasi takaran dosis serta aroma pewangi untuk bahan
                                pakaian Anda.<br><br>
                                Ada yang ingin Anda tanyakan seputar cucian hari ini?
                            </p>
                        </div>
                    </div>

                    <!-- Quick Suggestions -->
                    <div id="quickChips" class="flex flex-wrap gap-2 pt-1 pl-12">
                        <button type="button" onclick="sendQuickPrompt('Apa saja layanan dan harga yang tersedia?')"
                            class="text-xs bg-white hover:bg-orange-50 text-[#e87b24] border border-orange-200 rounded-full px-3.5 py-1.5 font-semibold transition shadow-sm">
                            👕 Daftar Layanan &amp; Harga
                        </button>
                        <button type="button"
                            onclick="sendQuickPrompt('Rekomendasi takaran dan aroma pewangi untuk 3 kg pakaian katun')"
                            class="text-xs bg-white hover:bg-orange-50 text-[#e87b24] border border-orange-200 rounded-full px-3.5 py-1.5 font-semibold transition shadow-sm">
                            🌸 Rekomendasi Pewangi Katun
                        </button>
                        <button type="button"
                            onclick="sendQuickPrompt('Berapa lama estimasi waktu pengerjaan untuk layanan ekspres dan reguler?')"
                            class="text-xs bg-white hover:bg-orange-50 text-[#e87b24] border border-orange-200 rounded-full px-3.5 py-1.5 font-semibold transition shadow-sm">
                            ⏱️ Estimasi Waktu Selesai
                        </button>
                    </div>
                </div>

                <!-- Divider -->
                <div class="border-t border-stone-200/80"></div>

                <!-- Input Area -->
                <div class="p-4 bg-white">
                    <!-- Error Banner -->
                    <div id="errorBanner"
                        class="hidden mb-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl px-4 py-2.5 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span id="errorText"></span>
                    </div>

                    <form id="chatForm" class="flex gap-3 items-end">
                        <div class="flex-1 relative">
                            <textarea id="messageInput"
                                placeholder="Ketik pertanyaan Anda seputar laundry... (maks. 500 karakter)"
                                maxlength="500" rows="1"
                                class="w-full border border-stone-300 rounded-2xl px-4 py-3 text-xs sm:text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-[#f38d38] focus:border-transparent resize-none transition-all"
                                style="min-height: 48px; max-height: 120px;" oninput="autoResize(this)"></textarea>
                            <span id="charCount"
                                class="absolute bottom-2 right-3 text-[10px] text-stone-400 font-medium">0/500</span>
                        </div>
                        <button type="submit" id="sendBtn"
                            class="btn-pill-orange text-xs sm:text-sm py-3 px-5 rounded-2xl shadow-sm flex items-center gap-2 flex-shrink-0">
                            <span id="sendBtnText">Kirim</span>
                            <svg id="sendIcon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                            <svg id="loadingIcon" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg"
                                fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                        </button>
                    </form>
                    <p class="text-[11px] text-stone-400 mt-2 text-center">AI hanya menjawab pertanyaan seputar
                        operasional Laundry Syah Jehan.</p>
                </div>
            </div>
        </div>
    </main>

    <script>
        const chatMessages = document.getElementById('chatMessages');
        const chatForm = document.getElementById('chatForm');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');
        const sendBtnText = document.getElementById('sendBtnText');
        const sendIcon = document.getElementById('sendIcon');
        const loadingIcon = document.getElementById('loadingIcon');
        const errorBanner = document.getElementById('errorBanner');
        const errorText = document.getElementById('errorText');
        const charCount = document.getElementById('charCount');

        function autoResize(el) {
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 120) + 'px';
            charCount.textContent = el.value.length + '/500';
        }

        messageInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                chatForm.requestSubmit();
            }
        });

        // Format pesan dari Markdown sederhana menjadi HTML bersih tanpa simbol bintang mentah
        function formatChatMessage(rawText) {
            if (!rawText) return '';

            // 1. Sanitasi karakter HTML agar aman dari XSS
            let safe = rawText
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            // 2. Ubah ***teks*** menjadi <strong><em>teks</em></strong>
            safe = safe.replace(/\*\*\*(.*?)\*\*\*/g, '<strong class="font-bold italic text-stone-900">$1</strong>');

            // 3. Ubah **teks** menjadi <strong>teks</strong> (teks tebal rapi tanpa tanda bintang)
            safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-stone-900">$1</strong>');

            // 4. Ubah bullet list "* poin" atau "- poin" menjadi bullet "• poin" yang rapi
            safe = safe.replace(/^[\s]*[\*\-]\s+(.*)$/gm, '<div class="flex items-start gap-2 my-1"><span class="text-[#f38d38] font-bold">•</span><span>$1</span></div>');

            // 5. Ubah baris baru (\n) menjadi <br>
            safe = safe.replace(/\n/g, '<br>');

            // 6. Bersihkan jika masih ada sisa-sisa tanda bintang liar
            safe = safe.replace(/\*/g, '');

            return safe;
        }

        function addMessage(role, text) {
            const isUser = role === 'user';
            const wrapper = document.createElement('div');
            wrapper.className = `flex items-start gap-3 ${isUser ? 'flex-row-reverse' : ''}`;

            const avatar = document.createElement('div');
            avatar.className = `w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm text-xs font-bold text-white ${isUser ? 'bg-stone-800' : 'bg-[#f38d38]'}`;
            avatar.innerHTML = `<span>${isUser ? 'Anda' : 'AI'}</span>`;

            const bubble = document.createElement('div');
            bubble.className = `rounded-2xl px-4 py-3 max-w-[80%] shadow-sm text-xs sm:text-sm leading-relaxed ${isUser
                    ? 'bg-[#f38d38] text-white rounded-tr-sm'
                    : 'bg-white border border-stone-200/80 text-stone-800 rounded-tl-sm'
                }`;

            // Tampilkan pesan dengan format rapi (tanda bintang hilang dan berubah jadi teks tebal)
            if (isUser) {
                bubble.textContent = text;
                bubble.style.whiteSpace = 'pre-wrap';
            } else {
                bubble.innerHTML = formatChatMessage(text);
            }

            wrapper.appendChild(avatar);
            wrapper.appendChild(bubble);
            chatMessages.appendChild(wrapper);
            scrollToBottom();
        }

        function addTypingIndicator() {
            const wrapper = document.createElement('div');
            wrapper.id = 'typingIndicator';
            wrapper.className = 'flex items-start gap-3';

            const avatar = document.createElement('div');
            avatar.className = 'w-9 h-9 rounded-xl bg-[#f38d38] flex items-center justify-center flex-shrink-0 shadow-sm text-xs font-bold text-white';
            avatar.innerHTML = '<span>AI</span>';

            const bubble = document.createElement('div');
            bubble.className = 'bg-white border border-stone-200/80 rounded-2xl rounded-tl-sm px-5 py-4 shadow-sm flex items-center gap-1.5';
            bubble.innerHTML = `
            <span class="w-2 h-2 bg-[#f38d38] rounded-full animate-bounce" style="animation-delay: 0ms"></span>
            <span class="w-2 h-2 bg-[#f38d38] rounded-full animate-bounce" style="animation-delay: 150ms"></span>
            <span class="w-2 h-2 bg-[#f38d38] rounded-full animate-bounce" style="animation-delay: 300ms"></span>
        `;

            wrapper.appendChild(avatar);
            wrapper.appendChild(bubble);
            chatMessages.appendChild(wrapper);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typingIndicator');
            if (indicator) indicator.remove();
        }

        function scrollToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function setLoading(isLoading) {
            sendBtn.disabled = isLoading;
            messageInput.disabled = isLoading;
            sendBtnText.textContent = isLoading ? 'Memproses' : 'Kirim';
            sendIcon.classList.toggle('hidden', isLoading);
            loadingIcon.classList.toggle('hidden', !isLoading);
        }

        function showError(msg) {
            errorText.textContent = msg;
            errorBanner.classList.remove('hidden');
            setTimeout(() => errorBanner.classList.add('hidden'), 5000);
        }

        function sendQuickPrompt(promptText) {
            messageInput.value = promptText;
            autoResize(messageInput);
            chatForm.requestSubmit();
        }

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = messageInput.value.trim();

            if (!message) {
                showError('Pesan tidak boleh kosong.');
                return;
            }
            if (message.length > 500) {
                showError('Pesan terlalu panjang. Maksimal 500 karakter.');
                return;
            }

            errorBanner.classList.add('hidden');
            const chips = document.getElementById('quickChips');
            if (chips) chips.remove();

            addMessage('user', message);

            messageInput.value = '';
            messageInput.style.height = 'auto';
            charCount.textContent = '0/500';

            setLoading(true);
            addTypingIndicator();

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message }),
                });

                const result = await response.json();
                removeTypingIndicator();

                if (result.success && result.data && result.data.reply) {
                    addMessage('ai', result.data.reply);
                } else {
                    const errMsg = result.error || 'Terjadi kesalahan. Silakan coba lagi.';
                    showError(errMsg);
                    addMessage('ai', `⚠️ ${errMsg}`);
                }
            } catch (err) {
                removeTypingIndicator();
                const errMsg = 'Gagal terhubung ke server. Pastikan koneksi internet Anda aktif.';
                showError(errMsg);
                addMessage('ai', `⚠️ ${errMsg}`);
            } finally {
                setLoading(false);
                messageInput.focus();
            }
        });
    </script>

    <%- include('partials/footer') %>