<%- include('partials/head') %>

    <main>
        <section class="top-strip text-white text-xs">
            <div class="max-w-6xl mx-auto px-5 py-2 flex flex-wrap justify-between gap-2">
                <span>Gratis antar-jemput untuk area terjangkau</span>
                <span>Senin–Minggu · 08.00–21.00 WIB</span>
            </div>
        </section>

        <div class="max-w-6xl mx-auto px-5">
            <nav class="py-5 flex items-center justify-between gap-5">
                <a href="/" class="flex items-center gap-3">
                    <span class="brand-mark">S</span>
                    <span class="leading-tight"><b class="block text-sky-950">SYAH</b><small
                            class="text-slate-500 font-semibold">LAUNDRY SERVICE</small></span>
                </a>
                <div class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-600">
                    <a class="nav-link active" href="/">Beranda</a>
                    <a class="nav-link" href="#layanan">Layanan</a>
                    <a class="nav-link" href="#cara-kerja">Cara Kerja</a>
                    <a class="nav-link" href="/chatbot">AI Assistant</a>
                    <a class="nav-link" href="/kelola">Kelola</a>
                </div>
                <% if (currentUser) { %>
                    <div class="flex items-center gap-3">
                        <% if (currentUser.role === 'admin') { %>
                            <a href="/admin/pesanan" class="text-sm font-bold text-blue-700 hover:text-blue-900">Dashboard Admin</a>
                        <% } else { %>
                            <a href="/pesanan-saya" class="text-sm font-bold text-blue-700 hover:text-blue-900">Pesanan Saya</a>
                        <% } %>
                        <form method="POST" action="/logout">
                            <button class="btn-primary text-sm px-4 py-2.5">Keluar</button>
                        </form>
                    </div>
                <% } else { %>
                    <a href="/login" class="btn-primary text-sm px-5 py-2.5">Masuk</a>
                <% } %>
            </nav>

            <section class="hero-card grid lg:grid-cols-2 items-center gap-8 mb-16 overflow-hidden">
                <div class="p-7 sm:p-10 lg:pr-2">
                    <p class="eyebrow">LAUNDRY ANDALAN ANDA</p>
                    <h1 class="text-4xl sm:text-5xl font-extrabold leading-[1.05] text-sky-950 mt-3">Pakaian
                        Bersih,<br><span class="text-blue-600">Hidup Lebih Segar!</span></h1>
                    <p class="text-slate-600 mt-5 max-w-md leading-relaxed">Cuci, kering, dan setrika yang praktis untuk
                        hari-hari Anda yang padat. Bersih, rapi, dan wangi setiap saat.</p>
                    <div class="flex flex-wrap gap-3 mt-7">
                        <% if (currentUser && currentUser.role === 'admin') { %>
                            <a href="/admin/pesanan" class="btn-primary">Kelola Pesanan</a>
                        <% } else { %>
                            <a href="<%= currentUser ? '/pesanan/baru' : '/login' %>" class="btn-primary">Pilih Layanan</a>
                        <% } %>
                        <a href="#cara-kerja" class="btn-outline">Pelajari Cara Kerja</a>
                    </div>
                    <div class="grid grid-cols-3 gap-3 mt-9 text-xs text-slate-600">
                        <div><b class="block text-blue-700 text-base">100%</b>Higienis</div>
                        <div><b class="block text-blue-700 text-base">1–2 Hari</b>Pengerjaan</div>
                        <div><b class="block text-blue-700 text-base">AI</b>Asisten Laundry</div>
                    </div>
                </div>
                <div class="hero-visual min-h-[320px] lg:min-h-[410px] relative">
                    <div class="bubble bubble-one"></div>
                    <div class="bubble bubble-two"></div>
                    <div class="machine">
                        <div class="machine-panel"></div>
                        <div class="machine-door">
                            <div></div>
                        </div>
                    </div>
                    <div class="laundry-basket"><i></i><i></i><i></i><i></i></div>
                    <span class="folded-clothes cloth-a"></span><span class="folded-clothes cloth-b"></span><span
                        class="folded-clothes cloth-c"></span>
                </div>
            </section>

            <section id="layanan" class="mb-16 scroll-mt-6">
                <div class="text-center mb-8">
                    <p class="eyebrow">LAYANAN KAMI</p>
                    <h2 class="section-title">Laundry &amp; Perawatan Pakaian</h2>
                    <p class="section-subtitle">Pilih layanan sesuai kebutuhan Anda.</p>
                </div>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    <% produk.forEach((item, index)=> { %>
                        <article class="service-card">
                            <div class="service-icon">
                                <%= ['◈', '◌' , '✦' ][index % 3] %>
                            </div>
                            <span class="service-tag">
                                <%= item.kategori %>
                            </span>
                            <h3>
                                <%= item.nama %>
                            </h3>
                            <p>
                                <%= item.deskripsi %>
                            </p>
                            <div class="mt-auto pt-5 flex justify-between items-end gap-2"><strong>Rp <%=
                                        item.harga.toLocaleString('id-ID') %><small>/kg</small></strong>
                                <% if (!currentUser || currentUser.role !== 'admin') { %>
                                    <a href="<%= currentUser ? '/pesanan/baru' : '/login' %>" class="availability hover:bg-green-100">Pilih layanan</a>
                                <% } %>
                            </div>
                        </article>
                        <% }) %>
                </div>
            </section>

            <section class="ai-banner mb-16">
                <div>
                    <p class="eyebrow text-blue-100">ASISTEN CERDAS</p>
                    <h2 class="text-2xl sm:text-3xl font-bold mt-2">Bingung memilih pewangi atau waktu selesai?</h2>
                    <p class="text-blue-100 mt-2">Tanyakan langsung kepada AI Assistant Laundry Syah Jehan.</p>
                </div>
                <a href="/chatbot"
                    class="bg-white text-blue-700 font-bold rounded-xl px-5 py-3 whitespace-nowrap hover:bg-blue-50 transition">Mulai
                    Chat →</a>
            </section>

            <section id="cara-kerja" class="mb-16 scroll-mt-6">
                <div class="text-center mb-8">
                    <p class="eyebrow">CARA KERJA</p>
                    <h2 class="section-title">Empat Langkah Mudah</h2>
                </div>
                <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <% 
                    const steps = [
                        ['01', 'Pilih Layanan', 'Tentukan layanan yang Anda perlukan.'],
                        ['02', 'Serahkan Cucian', 'Kami catat kebutuhan dan instruksi khusus.'],
                        ['03', 'Kami Kerjakan', 'Pakaian dicuci dengan teliti dan higienis.'],
                        ['04', 'Siap Diambil', 'Cucian rapi, wangi, dan siap digunakan.']
                    ];
                    steps.forEach(step => { 
                    %>
                        <div class="step-card">
                            <span><%= step[0] %></span>
                            <h3><%= step[1] %></h3>
                            <p><%= step[2] %></p>
                        </div>
                    <% }) %>
                </div>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>