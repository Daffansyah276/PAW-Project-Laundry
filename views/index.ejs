<%- include('partials/head') %>

    <main class="min-h-screen">
        <!-- Top Announcement Strip -->
        <div class="bg-[#211d1a] text-stone-300 text-xs py-2 px-6">
            <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-2">
                <span class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    Gratis antar-jemput area indekos &amp; kampus terdekat
                </span>
                <span class="text-stone-400">Senin – Minggu · 08.00 – 21.00 WIB</span>
            </div>
        </div>

        <div class="max-w-6xl mx-auto px-5 sm:px-6">
            <!-- Navbar (NeatWash Style) -->
            <nav class="py-6 flex items-center justify-between gap-6 border-b border-stone-200/60">
                <!-- Brand Logo -->
                <a href="/" class="flex items-center gap-3 group">
                    <img src="/images/logo.jpg" alt="SyahWash Logo"
                        class="h-11 sm:h-12 w-auto object-contain rounded-xl shadow-sm border border-stone-200/80 group-hover:scale-105 transition-transform bg-white p-0.5">
                    <span
                        class="font-display font-extrabold text-2xl tracking-tight text-stone-900 hidden sm:inline-block">
                        Syah<span class="text-[#f38d38]">Wash</span>
                    </span>
                </a>

                <!-- Center Nav Links -->
                <div class="hidden lg:flex items-center gap-8 text-sm font-semibold text-stone-600">
                    <a class="hover:text-[#f38d38] transition font-bold text-stone-900" href="/">Home</a>
                    <a class="hover:text-[#f38d38] transition" href="#layanan">Layanan</a>
                    <a class="hover:text-[#f38d38] transition" href="#about">Tentang Kami</a>
                    <a class="hover:text-[#f38d38] transition" href="#proses">Cara Kerja</a>
                    <a class="hover:text-[#f38d38] transition flex items-center gap-1.5" href="/chatbot">
                        <span>AI Assistant</span>
                        <span
                            class="px-2 py-0.5 text-[10px] bg-orange-100 text-[#e87b24] rounded-full font-bold">Gemini</span>
                    </a>
                    <% if (currentUser && currentUser.role==='admin' ) { %>
                        <a class="hover:text-[#f38d38] transition text-[#e87b24]" href="/kelola">Kelola Layanan</a>
                        <% } %>
                </div>

                <!-- Right Action Buttons -->
                <div class="flex items-center gap-3">
                    <% if (currentUser) { %>
                        <% if (currentUser.role==='admin' ) { %>
                            <a href="/admin/pesanan"
                                class="text-sm font-bold text-stone-700 hover:text-[#f38d38] transition mr-1">Dashboard
                                Admin</a>
                            <% } else { %>
                                <a href="/pesanan-saya"
                                    class="text-sm font-bold text-stone-700 hover:text-[#f38d38] transition mr-1">Pesanan
                                    Saya</a>
                                <% } %>
                                    <form method="POST" action="/logout">
                                        <button class="btn-pill-orange text-xs py-2 px-5">Keluar</button>
                                    </form>
                                    <% } else { %>
                                        <a href="/login" class="btn-pill-orange text-sm py-2.5 px-6">
                                            Masuk / Daftar
                                        </a>
                                        <% } %>
                </div>
            </nav>

            <!-- HERO SECTION (Persis Desain NeatWash) -->
            <section
                class="mt-8 mb-20 bg-white border border-stone-200/80 rounded-[2.5rem] p-7 sm:p-12 shadow-xl shadow-stone-900/5 overflow-hidden">
                <div class="grid lg:grid-cols-12 items-center gap-10">
                    <!-- Kiri: Headline & CTA -->
                    <div class="lg:col-span-5">
                        <span
                            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-xs font-bold text-[#e87b24] mb-5 tracking-wide">
                            ★ SMART LAUNDRY SERVICE
                        </span>
                        <h1
                            class="font-display text-4xl sm:text-5xl font-extrabold text-stone-900 leading-[1.1] tracking-tight">
                            Delivering excellence every step ahead
                        </h1>
                        <p class="mt-5 text-stone-500 text-sm sm:text-base leading-relaxed">
                            Layanan cuci, kering, dan setrika higienis dengan pewangi tahan lama. Konsultasikan waktu
                            selesai dan takaran pewangi terbaik melalui <b>AI Assistant</b> pintar kami.
                        </p>
                        <div class="mt-8 flex flex-wrap items-center gap-3">
                            <% if (currentUser && currentUser.role==='admin' ) { %>
                                <a href="/admin/pesanan" class="btn-pill-orange text-sm py-3.5 px-7">Kelola Antrean
                                    Pesanan</a>
                                <% } else { %>
                                    <a href="<%= currentUser ? '/pesanan/baru' : '/login' %>"
                                        class="btn-pill-orange text-sm py-3.5 px-7">
                                        Pilih Layanan &amp; Pesan
                                    </a>
                                    <% } %>
                                        <a href="/chatbot"
                                            class="btn-pill-light text-sm py-3.5 px-6 flex items-center gap-2">
                                            <span></span> Tanya AI Assistant
                                        </a>
                        </div>
                    </div>

                    <!-- Kanan: Foto Tumpukan Baju + 3 Floating Badges -->
                    <div class="lg:col-span-7 relative">
                        <div class="grid sm:grid-cols-12 gap-5 items-center">
                            <!-- Main Hero Image (Tumpukan Baju Rapi Warna-Warni) -->
                            <div
                                class="sm:col-span-7 relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white aspect-[4/5] max-h-[460px]">
                                <img src="https://static.vecteezy.com/system/resources/previews/005/226/405/large_2x/laundry-with-wash-and-drying-machines-in-flat-background-illustration-dirty-cloth-lying-in-basket-and-women-are-washing-clothes-for-banner-or-poster-vector.jpg"
                                    alt="Pakaian bersih, wangi, dan rapi"
                                    class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700">
                                <div
                                    class="absolute inset-0 bg-gradient-to-t from-stone-900/30 to-transparent pointer-events-none">
                                </div>
                            </div>

                            <!-- 3 Floating Feature Badges di samping foto -->
                            <div class="sm:col-span-5 flex flex-col gap-3.5">
                                <!-- Badge 1 -->
                                <div
                                    class="bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-stone-200/90 shadow-md flex items-center gap-3.5 transition hover:-translate-y-1">
                                    <div
                                        class="w-11 h-11 rounded-xl bg-blue-100 flex items-center justify-center text-blue-600 text-xl flex-shrink-0">
                                        👕
                                    </div>
                                    <div>
                                        <h4 class="font-display font-bold text-xs text-stone-900 leading-tight">Soft,
                                            fresh &amp; revitalized</h4>
                                        <p class="text-[11px] text-stone-500 mt-0.5">Pakaian wangi, bersih, dan segar
                                            terawat</p>
                                    </div>
                                </div>

                                <!-- Badge 2 -->
                                <div
                                    class="bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-stone-200/90 shadow-md flex items-center gap-3.5 transition hover:-translate-y-1">
                                    <div
                                        class="w-11 h-11 rounded-xl bg-orange-100 flex items-center justify-center text-orange-600 text-xl flex-shrink-0">
                                        ✨
                                    </div>
                                    <div>
                                        <h4 class="font-display font-bold text-xs text-stone-900 leading-tight">Expertly
                                            dry-cleaned</h4>
                                        <p class="text-[11px] text-stone-500 mt-0.5">Hasil cucian rapi bebas kusut</p>
                                    </div>
                                </div>

                                <!-- Badge 3 -->
                                <div
                                    class="bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-stone-200/90 shadow-md flex items-center gap-3.5 transition hover:-translate-y-1">
                                    <div
                                        class="w-11 h-11 rounded-xl bg-amber-100 flex items-center justify-center text-amber-600 text-xl flex-shrink-0">
                                        🌸
                                    </div>
                                    <div>
                                        <h4 class="font-display font-bold text-xs text-stone-900 leading-tight">Delicate
                                            fabrics treated</h4>
                                        <p class="text-[11px] text-stone-500 mt-0.5">Rekomendasi dosis pewangi AI teruji
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION: About us beyond your expectations -->
            <section id="about" class="mb-24">
                <div class="grid lg:grid-cols-12 gap-10 items-center">
                    <!-- Kiri: Deskripsi & Stat Card -->
                    <div class="lg:col-span-5">
                        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-stone-900 leading-tight">
                            About us beyond your expectations
                        </h2>
                        <p class="mt-4 text-stone-600 text-sm leading-relaxed">
                            Kami menghadirkan standar laundry modern untuk Anda yang memiliki jadwal padat. Didukung
                            mesin cuci higienis, formula pelembut ramah serat kain, dan sistem pemantauan status pesanan
                            secara transparan.
                        </p>
                        <div class="mt-7 flex items-center gap-4">
                            <div
                                class="inline-flex flex-col items-center justify-center bg-[#f38d38] text-white px-6 py-3.5 rounded-full shadow-lg shadow-orange-500/25">
                                <span class="font-display font-extrabold text-2xl leading-none">1000+</span>
                                <span class="text-[11px] font-medium opacity-90 mt-0.5">Pelanggan Aktif</span>
                            </div>
                            <p class="text-xs text-stone-500 max-w-[200px] leading-snug">
                                Kepercayaan pelanggan indekos, mahasiswa, dan keluarga setiap bulannya.
                            </p>
                        </div>
                    </div>

                    <!-- Kanan: 2 Foto Proses Laundry -->
                    <div class="lg:col-span-7 grid sm:grid-cols-2 gap-5">
                        <div class="rounded-3xl overflow-hidden shadow-lg border-2 border-white aspect-[4/3]">
                            <img src="https://images.unsplash.com/photo-1545173168-9f1947eebb7f?auto=format&fit=crop&w=600&q=80"
                                alt="Proses gantungan dan penyusunan baju"
                                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
                        </div>
                        <div class="rounded-3xl overflow-hidden shadow-lg border-2 border-white aspect-[4/3]">
                            <img src="https://images.unsplash.com/photo-1517677208171-0bc6725a3e60?auto=format&fit=crop&w=600&q=80"
                                alt="Petugas melipat pakaian dengan teliti"
                                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION: 3 Pastel Service Highlights (NeatWash Top Cards) -->
            <section class="mb-14">
                <div class="text-center max-w-xl mx-auto mb-10">
                    <span class="text-xs font-bold uppercase tracking-wider text-[#e87b24]">LAYANAN SPESIALIS</span>
                    <h2 class="font-display text-3xl font-extrabold text-stone-900 mt-1">
                        Expert laundry services delivered fresh
                    </h2>
                    <p class="text-stone-500 text-xs sm:text-sm mt-2">
                        Tiga pilar layanan utama untuk menjaga pakaian kesayangan Anda selalu bersih dan wangi.
                    </p>
                </div>

                <!-- 3 Pastel Cards: Orange, Yellow, Soft Blue -->
                <div class="grid md:grid-cols-3 gap-6">
                    <!-- Card 1: Orange Pastel -->
                    <div
                        class="bg-[#f78e3d] text-white p-7 rounded-[2rem] shadow-xl shadow-orange-500/15 flex flex-col items-center text-center transition hover:-translate-y-1.5">
                        <div
                            class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center text-3xl mb-4 border border-white/20">
                            🧺
                        </div>
                        <h3 class="font-display font-extrabold text-xl">Quick Wash</h3>
                        <p class="text-xs text-orange-50 mt-2 leading-relaxed">
                            Pencucian cepat dan higienis untuk kebutuhan pakaian sehari-hari tanpa kompromi kebersihan.
                        </p>
                    </div>

                    <!-- Card 2: Amber Yellow Pastel -->
                    <div
                        class="bg-[#eab348] text-white p-7 rounded-[2rem] shadow-xl shadow-amber-500/15 flex flex-col items-center text-center transition hover:-translate-y-1.5">
                        <div
                            class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center text-3xl mb-4 border border-white/20">
                            💨
                        </div>
                        <h3 class="font-display font-extrabold text-xl">Fresh Press</h3>
                        <p class="text-xs text-amber-50 mt-2 leading-relaxed">
                            Penyetrikaan uap presisi agar pakaian bebas kusut, licin, dan harum semerbak sepanjang hari.
                        </p>
                    </div>

                    <!-- Card 3: Soft Blue/Lavender Pastel -->
                    <div
                        class="bg-[#8fa4e8] text-white p-7 rounded-[2rem] shadow-xl shadow-indigo-500/15 flex flex-col items-center text-center transition hover:-translate-y-1.5">
                        <div
                            class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center text-3xl mb-4 border border-white/20">
                            🧼
                        </div>
                        <h3 class="font-display font-extrabold text-xl">Stain Removal</h3>
                        <p class="text-xs text-indigo-50 mt-2 leading-relaxed">
                            Perawatan khusus noda membandel pada sepatu, seprai, dan bahan kain sensitif.
                        </p>
                    </div>
                </div>
            </section>

            <!-- SECTION: KATALOG LAYANAN DENGAN GAMBAR (Semua Layanan Memiliki Gambar Nyata!) -->
            <section id="layanan" class="mb-24 scroll-mt-10">
                <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-[#e87b24]">DAFTAR PRODUK &amp;
                            TARIF</span>
                        <h2 class="font-display text-3xl font-extrabold text-stone-900 mt-1">
                            Semua Paket Layanan Kami
                        </h2>
                        <p class="text-stone-500 text-xs sm:text-sm mt-1">
                            Data riil dari database PostgreSQL dengan harga transparan dan higienis.
                        </p>
                    </div>
                    <a href="/chatbot"
                        class="inline-flex items-center gap-1.5 text-xs font-bold text-[#e87b24] hover:text-[#c26214] bg-orange-50 px-4 py-2 rounded-full border border-orange-200">
                        <span>💡</span> Tanya AI untuk Rekomendasi Pewangi &rarr;
                    </a>
                </div>

                <!-- Grid Layanan dengan Gambar -->
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-7">
                    <% const serviceImages={ 'Cuci Komplit Reguler'
                        : 'https://images.unsplash.com/photo-1582735689369-4fe89db7114c?auto=format&fit=crop&w=700&q=80'
                        , 'Cuci Komplit Ekspres'
                        : 'https://images.unsplash.com/photo-1517677208171-0bc6725a3e60?auto=format&fit=crop&w=700&q=80'
                        , 'Setrika Saja'
                        : 'https://images.unsplash.com/photo-1489274495757-95c7c837b101?auto=format&fit=crop&w=700&q=80'
                        , 'Cuci Sepatu Premium'
                        : 'https://cms.kartinimedia.id/assets/img/202307230150164047-106035-1512_Freepik.jpg'
                        , 'Cuci Seprai'
                        : 'data:image/webp;base64,'
                        }; const
                        defaultImage='https://images.unsplash.com/photo-1545173168-9f1947eebb7f?auto=format&fit=crop&w=700&q=80'
                        ; produk.forEach(function(item) { const imageUrl=serviceImages[item.nama] || defaultImage; %>
                        <article
                            class="service-img-card bg-white border border-stone-200/90 rounded-3xl overflow-hidden shadow-sm flex flex-col">
                            <!-- Foto Layanan Nyata -->
                            <div class="relative w-full h-48 overflow-hidden bg-stone-100">
                                <img src="<%= imageUrl %>" alt="<%= item.nama %>"
                                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                                    loading="lazy">
                                <!-- Badge Kategori -->
                                <span
                                    class="absolute top-3.5 left-3.5 bg-white/95 backdrop-blur-sm text-stone-800 text-[11px] font-bold px-3 py-1 rounded-full shadow-sm">
                                    <%= item.kategori %>
                                </span>
                                <!-- Badge Stok/Status -->
                                <span
                                    class="absolute top-3.5 right-3.5 bg-emerald-500/95 text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full shadow-sm">
                                    <%= item.stok || 'Tersedia' %>
                                </span>
                            </div>

                            <!-- Konten Kartu -->
                            <div class="p-6 flex-1 flex flex-col justify-between">
                                <div>
                                    <h3 class="font-display font-extrabold text-lg text-stone-900 leading-snug">
                                        <%= item.nama %>
                                    </h3>
                                    <p class="text-stone-500 text-xs sm:text-sm mt-2 leading-relaxed line-clamp-2">
                                        <%= item.deskripsi %>
                                    </p>
                                </div>

                                <div
                                    class="mt-6 pt-4 border-t border-stone-100 flex items-center justify-between gap-3">
                                    <div>
                                        <span class="text-[10px] uppercase font-bold text-stone-400 block">Tarif
                                            Layanan</span>
                                        <strong class="font-display font-black text-xl text-[#f38d38]">
                                            Rp <%= item.harga.toLocaleString('id-ID') %><small
                                                    class="text-xs font-semibold text-stone-500">/kg</small>
                                        </strong>
                                    </div>

                                    <% if (!currentUser || currentUser.role !=='admin' ) { %>
                                        <a href="<%= currentUser ? '/pesanan/baru' : '/login' %>"
                                            class="btn-pill-orange text-xs py-2 px-4 shadow-sm">
                                            Pilih Layanan
                                        </a>
                                        <% } else { %>
                                            <a href="/kelola" class="btn-pill-light text-xs py-2 px-3 text-stone-600">
                                                Edit Tarif
                                            </a>
                                            <% } %>
                                </div>
                            </div>
                        </article>
                        <% }) %>
                </div>
            </section>

            <!-- SECTION: From humble beginnings to excellence (Timeline Visual) -->
            <section class="mb-24 bg-white border border-stone-200/80 rounded-[2.5rem] p-7 sm:p-12 shadow-sm">
                <div class="text-center max-w-xl mx-auto mb-10">
                    <span class="text-xs font-bold uppercase tracking-wider text-[#e87b24]">KOMITMEN &amp;
                        PERJALANAN</span>
                    <h2 class="font-display text-3xl font-extrabold text-stone-900 mt-1">
                        From humble beginnings to excellence
                    </h2>
                    <p class="text-stone-500 text-xs sm:text-sm mt-2">
                        Dedikasi kami berkembang dari layanan cucian lokal hingga sistem pintar dengan AI.
                    </p>
                </div>

                <!-- Mini Milestone Cards -->
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                    <!-- Milestone 1 -->
                    <div class="bg-[#faf7f2] p-3.5 rounded-2xl border border-stone-200/60 text-center">
                        <img src="https://images.unsplash.com/photo-1582735689369-4fe89db7114c?auto=format&fit=crop&w=300&q=80"
                            alt="Foundation" class="w-full h-24 object-cover rounded-xl mb-2.5">
                        <h5 class="font-display font-bold text-xs text-stone-900">Foundation</h5>
                        <p class="text-[10px] text-stone-500 mt-0.5">Fokus kebersihan higienis</p>
                    </div>
                    <!-- Milestone 2 -->
                    <div class="bg-[#faf7f2] p-3.5 rounded-2xl border border-stone-200/60 text-center">
                        <img src="https://images.unsplash.com/photo-1545173168-9f1947eebb7f?auto=format&fit=crop&w=300&q=80"
                            alt="Local Launch" class="w-full h-24 object-cover rounded-xl mb-2.5">
                        <h5 class="font-display font-bold text-xs text-stone-900">Local Launch</h5>
                        <p class="text-[10px] text-stone-500 mt-0.5">Area indekos &amp; mahasiswa</p>
                    </div>
                    <!-- Milestone 3 -->
                    <div class="bg-[#faf7f2] p-3.5 rounded-2xl border border-stone-200/60 text-center">
                        <img src="https://images.unsplash.com/photo-1517677208171-0bc6725a3e60?auto=format&fit=crop&w=300&q=80"
                            alt="Growth & Care" class="w-full h-24 object-cover rounded-xl mb-2.5">
                        <h5 class="font-display font-bold text-xs text-stone-900">Quality Care</h5>
                        <p class="text-[10px] text-stone-500 mt-0.5">Detergen ramah lingkungan</p>
                    </div>
                    <!-- Milestone 4 -->
                    <div class="bg-[#faf7f2] p-3.5 rounded-2xl border border-stone-200/60 text-center">
                        <img src="https://images.unsplash.com/photo-1489274495757-95c7c837b101?auto=format&fit=crop&w=300&q=80"
                            alt="Smart Laundry" class="w-full h-24 object-cover rounded-xl mb-2.5">
                        <h5 class="font-display font-bold text-xs text-stone-900">Smart AI</h5>
                        <p class="text-[10px] text-stone-500 mt-0.5">Integrasi Google Gemini</p>
                    </div>
                    <!-- Milestone 5 -->
                    <div
                        class="bg-[#faf7f2] p-3.5 rounded-2xl border border-stone-200/60 text-center col-span-2 sm:col-span-1">
                        <img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=300&q=80"
                            alt="Customer First" class="w-full h-24 object-cover rounded-xl mb-2.5">
                        <h5 class="font-display font-bold text-xs text-stone-900">Customer Care</h5>
                        <p class="text-[10px] text-stone-500 mt-0.5">Tepat waktu &amp; terpercaya</p>
                    </div>
                </div>
            </section>

            <!-- SECTION: Laundry process for fresh laundry about clean (4 Steps with Avatars) -->
            <section id="proses" class="mb-24">
                <div class="text-center max-w-xl mx-auto mb-14">
                    <span class="text-xs font-bold uppercase tracking-wider text-[#e87b24]">ALUR KERJA</span>
                    <h2 class="font-display text-3xl font-extrabold text-stone-900 mt-1">
                        Laundry process for fresh laundry about clean
                    </h2>
                    <p class="text-stone-500 text-xs sm:text-sm mt-2">
                        Empat langkah praktis memastikan pakaian Anda kembali dalam kondisi terbaik.
                    </p>
                </div>

                <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
                    <!-- Step 1: Orange -->
                    <div class="flex flex-col items-center text-center">
                        <div class="relative mb-4">
                            <div class="w-24 h-24 rounded-full overflow-hidden shadow-lg border-4 border-white">
                                <img src="https://indradp.com/wp-content/uploads/2026/05/ilustrasi-laundry-premium.webp"
                                    alt="Pilih Layanan" class="w-full h-full object-cover">
                            </div>
                            <span
                                class="absolute -top-1 -right-1 w-8 h-8 rounded-full bg-[#f38d38] text-white font-display font-extrabold text-sm flex items-center justify-center shadow-md">1</span>
                        </div>
                        <h4 class="font-display font-extrabold text-base text-stone-900">Pilih Layanan</h4>
                        <p class="text-stone-500 text-xs mt-1.5 max-w-[200px]">Tentukan paket kiloan atau satuan melalui
                            website.</p>
                    </div>

                    <!-- Step 2: Yellow/Amber -->
                    <div class="flex flex-col items-center text-center">
                        <div class="relative mb-4">
                            <div class="w-24 h-24 rounded-full overflow-hidden shadow-lg border-4 border-white">
                                <img src="https://assets-a1.kompasiana.com/items/album/2022/01/17/8-revealing-laundry-secrets-from-5-star-hotels-61e5916980a65a2dd30d9265.jpg?t=o&v=1200"
