<%- include('partials/head') %>

<main class="min-h-[calc(100vh-260px)]">
    <div class="max-w-6xl mx-auto px-5">
        <nav class="py-5 flex items-center justify-between border-b border-stone-200">
            <a href="/" class="flex items-center gap-2.5">
                <img src="/images/logo.jpg" alt="SyahWash Logo" class="h-10 w-auto object-contain rounded-xl shadow-sm border border-stone-200 bg-white p-0.5">
                <span class="font-display font-extrabold text-xl tracking-tight text-stone-900">Syah<span class="text-[#f38d38]">Wash</span></span>
            </a>
            <a href="/" class="btn-pill-light text-xs sm:text-sm py-2 px-4">&larr; Kembali ke Beranda</a>
        </nav>

        <section class="grid lg:grid-cols-2 max-w-5xl mx-auto my-10 lg:my-16 bg-white rounded-3xl overflow-hidden border border-stone-200 shadow-xl shadow-stone-900/5">
            <!-- Sisi Kiri: Panel Teks Awal (Tanpa Gambar Foto) -->
            <div class="hidden lg:flex p-10 flex-col justify-between text-white min-h-[560px] bg-gradient-to-br from-[#1c1917] via-[#292524] to-[#44403c]">
                <div>
                    <span class="inline-flex bg-white/15 border border-white/25 px-3 py-1.5 rounded-full text-xs font-bold tracking-wide">
                        SMARTLAUNDRY AI
                    </span>
                    <h1 class="font-display text-4xl font-extrabold leading-tight mt-6">
                        Kelola laundry dengan lebih mudah.
                    </h1>
                    <p class="text-stone-300 mt-4 leading-relaxed text-sm">
                        Satu tempat untuk melihat layanan dan mendapatkan bantuan dari AI Assistant Laundry Syah Jehan.
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div class="bg-white/10 rounded-xl p-4 border border-white/10">
                        <b class="block text-xl font-display font-bold">Cepat</b>
                        <span class="text-stone-300 text-xs">Akses layanan</span>
                    </div>
                    <div class="bg-white/10 rounded-xl p-4 border border-white/10">
                        <b class="block text-xl font-display font-bold">Praktis</b>
                        <span class="text-stone-300 text-xs">Bantuan AI</span>
                    </div>
                </div>
            </div>

            <!-- Sisi Kanan: Form Masuk Akun -->
            <div class="p-7 sm:p-10 lg:p-12 flex flex-col justify-center">
                <p class="text-xs font-extrabold tracking-wider uppercase text-[#e87b24]">SELAMAT DATANG</p>
                <h2 class="text-3xl font-extrabold text-stone-900 mt-2 font-display">Masuk ke akun Anda</h2>
                <p class="text-stone-500 text-sm mt-2">Masukkan detail akun untuk melanjutkan.</p>

                <% if (typeof error !== 'undefined' && error) { %>
                    <p class="mt-5 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700"><%= error %></p>
                <% } %>

                <form method="POST" action="/login" class="mt-8 space-y-5">
                    <label class="block text-sm font-bold text-stone-700">
                        Email
                        <input name="email" type="email" required placeholder="nama@email.com" class="login-input mt-2">
                    </label>

                    <label class="block text-sm font-bold text-stone-700">
                        Kata sandi
                        <input name="password" type="password" required placeholder="Masukkan kata sandi" class="login-input mt-2">
                    </label>

                    <div class="flex items-center justify-between text-sm">
                        <label class="flex items-center gap-2 text-stone-500 cursor-pointer">
                            <input type="checkbox" class="accent-[#f38d38]"> Ingat saya
                        </label>
                        <span class="text-stone-400 text-xs">Laundry Syah Jehan</span>
                    </div>

                    <button type="submit" class="btn-pill-orange w-full py-3.5 text-sm">Masuk</button>
                </form>

                <p class="text-center text-sm text-stone-500 mt-6">
                    Belum punya akun? 
                    <a href="/register" class="font-bold text-[#e87b24] hover:underline">Daftar sekarang</a>
                </p>
            </div>
        </section>
    </div>
</main>

<%- include('partials/footer') %>
