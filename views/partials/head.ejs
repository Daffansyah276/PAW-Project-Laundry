<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laundry Syah Jehan - Delivering Excellence Every Step Ahead</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <!-- Google Fonts Plus Jakarta Sans / Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            orange: '#f38d38',
                            hover: '#e07a27',
                            amber: '#f59e0b',
                            cream: '#fdfbf7',
                            card: '#faf6f0',
                            dark: '#211d1a',
                            muted: '#78716c'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Outfit"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { 
            background-color: #faf7f2; 
            color: #292524;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow-x: hidden;
        }
        h1, h2, h3, h4, .font-display {
            font-family: 'Outfit', sans-serif;
        }
        .bg-warm-cream { background-color: #faf7f2; }
        .bg-warm-card { background-color: #ffffff; }
        .btn-pill-orange {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f5913e, #e87b24);
            color: #ffffff;
            font-weight: 700;
            padding: 0.75rem 1.75rem;
            border-radius: 9999px;
            box-shadow: 0 10px 25px -5px rgba(243, 141, 56, 0.4);
            transition: all 0.25s ease;
        }
        .btn-pill-orange:hover {
            background: linear-gradient(135deg, #e87b24, #d56a15);
            transform: translateY(-2px);
            box-shadow: 0 14px 28px -5px rgba(243, 141, 56, 0.5);
        }
        .btn-pill-light {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            color: #44403c;
            border: 1px solid #e7e5e4;
            font-weight: 700;
            padding: 0.75rem 1.6rem;
            border-radius: 9999px;
            transition: all 0.2s ease;
        }
        .btn-pill-light:hover {
            background: #f5f5f4;
            color: #1c1917;
            border-color: #d6d3d1;
        }
        .service-img-card {
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .service-img-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.08);
        }
        .floating-badge {
            animation: floatSlow 4s ease-in-out infinite alternate;
        }
        @keyframes floatSlow {
            0% { transform: translateY(0px); }
            100% { transform: translateY(-6px); }
        }
        .status-pill {
            height: max-content;
            border-radius: 999px;
            padding: 0.35rem 0.75rem;
            font-size: 0.72rem;
            font-weight: 800;
        }
        .status-Dicuci { background: #ffedd5; color: #c2410c; }
        .status-Kering { background: #fef3c7; color: #b45309; }
        .status-Disetrika { background: #f3e8ff; color: #7e22ce; }
        .status-Siap-Ambil { background: #dcfce7; color: #15803d; }
        .status-Diambil { background: #e7e5e4; color: #57534e; }
        .login-input {
            width: 100%;
            border: 1px solid #e7e5e4;
            border-radius: 0.85rem;
            padding: 0.8rem 1rem;
            color: #1c1917;
            background: #ffffff;
            outline: none;
            transition: 0.2s;
        }
        .login-input:focus {
            border-color: #f38d38;
            box-shadow: 0 0 0 3px rgba(243, 141, 56, 0.18);
        }
    </style>
</head>
<body class="bg-[#faf7f2] text-stone-800 antialiased selection:bg-orange-200 selection:text-orange-900">
