<%- include('partials/head') %>
<main class="min-h-[calc(100vh-260px)]"><div class="max-w-6xl mx-auto px-5 py-8">
    <div class="flex flex-wrap justify-between gap-4 items-center mb-8"><a href="/" class="flex items-center gap-3"><span class="brand-mark">S</span><b class="text-sky-950">SYAH LAUNDRY</b></a><div class="flex gap-3"><a href="/chatbot" class="btn-outline text-sm py-2 px-4">Tanya AI</a><a href="/pesanan/baru" class="btn-primary text-sm py-2 px-4">+ Pesanan Baru</a></div></div>
    <div class="grid lg:grid-cols-[1fr_330px] gap-7"><section><p class="eyebrow">PELANGGAN</p><h1 class="section-title mb-6">Pesanan Saya</h1><div class="space-y-4"><% if (!pesanan.length) { %><div class="bg-white border border-blue-100 rounded-xl p-6 text-slate-500">Belum ada pesanan. <a href="/pesanan/baru" class="font-bold text-blue-600">Buat pesanan pertama Anda.</a></div><% } %><% pesanan.forEach(item => { %><article class="bg-white border border-blue-100 rounded-xl p-5 shadow-sm"><div class="flex flex-wrap gap-3 justify-between"><div><p class="text-xs font-bold text-blue-600"><%= item.kode %></p><h2 class="font-extrabold text-sky-950 text-lg mt-1"><%= item.layanan %></h2><p class="text-sm text-slate-500 mt-1"><%= item.berat %> kg · <%= formatRupiah(item.hargaPerKg * item.berat) %></p></div><span class="status-pill status-<%= item.status.replace(' ', '-') %>"><%= item.status %></span></div><p class="text-sm text-slate-600 mt-4">Estimasi selesai: <b><%= new Date(item.estimasiSelesai).toLocaleDateString('id-ID', { dateStyle: 'full' }) %></b></p><% if(item.catatan) { %><p class="text-sm text-slate-500 mt-1">Catatan: <%= item.catatan %></p><% } %></article><% }) %></div></section>
    <aside class="bg-white border border-blue-100 rounded-xl p-5 h-fit"><p class="eyebrow">PEMBERITAHUAN</p><h2 class="font-extrabold text-sky-950 text-lg mt-1 mb-4">Update Cucian</h2><div class="space-y-3"><% if (!notifikasi.length) { %><p class="text-sm text-slate-500">Belum ada pemberitahuan.</p><% } %><% notifikasi.forEach(item => { %><div class="border-l-4 border-blue-500 bg-blue-50 p-3 text-sm text-slate-700"><%= item.pesan %><p class="text-xs text-slate-400 mt-1"><%= new Date(item.createdAt).toLocaleString('id-ID') %></p></div><% }) %></div></aside></div>
</div></main>
<%- include('partials/footer') %>
